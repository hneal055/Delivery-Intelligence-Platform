{
  "expo": {
    "name": "Delivery Intelligence Platform",
    "slug": "delivery-intelligence-platform",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deliveryintelligence.platform",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to photograph proof of delivery and scan barcodes.",
        "NSPhotoLibraryUsageDescription": "This app requires photo library access to upload proof of delivery."
      }
    },
    "android": {
      "package": "com.deliveryintelligence.platform",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    }
  }
}