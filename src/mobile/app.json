{
  "expo": {
    "name": "Delivery Intelligence",
    "slug": "delivery-intelligence-platform",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deliveryintelligence.platform",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires access to the camera to scan package barcodes and capture delivery proof photos.",
        "NSLocationWhenInUseUsageDescription": "This app requires real-time GPS coordinates to record proof-of-delivery location at the delivery stop."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.deliveryintelligence.platform",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Delivery Intelligence to access your camera to scan barcodes and take proof photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Delivery Intelligence to access your location to verify delivery proof."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "1d2de5ee-3c67-4fc2-a534-06e2e3c01b74"
      }
    },
    "owner": "hneal1038"
  }
}