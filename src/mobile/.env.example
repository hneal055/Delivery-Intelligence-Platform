# Mobile App Environment Configuration

# Backend API Configuration
# For physical iOS device testing: Set to your PC's LAN IP (e.g., 192.168.1.100)
# For iOS Simulator: Use 'localhost'
# For Android Emulator: Use '10.0.2.2' (Android's localhost alias)
EXPO_PUBLIC_API_HOST=192.168.12.196
EXPO_PUBLIC_API_PORT=8002

# Optional: Set custom timeout for API requests (milliseconds)
# EXPO_PUBLIC_API_TIMEOUT=15000

