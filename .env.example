# .env.example — Copy to .env and fill in real values. Never commit .env to git.

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_DB_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# ── Grafana ───────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_THIS_GRAFANA_PASSWORD

# ── Notifications (leave empty to disable) ────────────────────────────────────
NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# ── Storage (leave PROOF_STORAGE=local for dev) ───────────────────────────────
PROOF_STORAGE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=delivery-proofs
S3_ENDPOINT_URL=http://localstack:4566

# ── Mapbox (leave empty to use haversine fallback) ────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ── Firebase Push Notifications (leave empty to disable) ─────────────────────
FIREBASE_CREDENTIALS_JSON=

# ── OIDC / SSO (leave empty to use local JWT auth) ───────────────────────────
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" on live servers — triggers SECRET_KEY strength check and JSON logging
ENV=development
