# Local development .env
# DO NOT COMMIT

# ── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=dev-only-secret-key-not-for-production-use

# ── Environment ─────────────────────────────────────────────────────────────
ENV=development

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/delivery_db

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=devredis
REDIS_URL=redis://:devredis@localhost:6379/0

# ── Grafana ─────────────────────────────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=new_bizness123

# ── Notifications ───────────────────────────────────────────────────────────
NOTIFICATIONS_ENABLED=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com

# ── Storage ─────────────────────────────────────────────────────────────────
PROOF_STORAGE=local

# ── AWS / LocalStack ────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=delivery-proofs
S3_ENDPOINT_URL=http://localstack:4566

# ── Cloudflare R2 (optional) ────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Mapbox ──────────────────────────────────────────────────────────────────
MAPBOX_ACCESS_TOKEN=

# ── TomTom ──────────────────────────────────────────────────────────────────
TOMTOM_API_KEY=BFcLXS33MZRsUUcS0X5XFBxmahUX7Cfh

# ── Firebase ────────────────────────────────────────────────────────────────
FIREBASE_CREDENTIALS_JSON=

# ── OIDC / Microsoft Entra ID ───────────────────────────────────────────────
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── Authentication ──────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080