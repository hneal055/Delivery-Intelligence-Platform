# Device key for scanners/devices (X-DIAD-Token). Production needs 32+ random
# characters; configure-public-access.ps1 generates one. Example:
#   python -c "import secrets; print(secrets.token_hex(32))"
DIAD_API_KEY=
DRIVER_PASSWORD=your-driver-password-here
BACKEND_URL=http://localhost:8002

# Signs login tokens. Required by docker-compose. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Customer updates: public tracking page /track/<code> and texts to recipients
PUBLIC_BASE_URL=https://dip.chicagocargocourier.com
COMPANY_NAME=Chicago Cargo Couriers
COMPANY_PHONE=
# Customer SMS through Twilio; leave blank to keep texts off. Trust Hub
# business-profile approval alone is not sender registration: finish A2P
# 10DLC campaign registration or toll-free verification as applicable.
# Set the account SID and auth token, plus either a sending number or
# Messaging Service SID. Never commit real credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
